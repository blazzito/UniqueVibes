	<div class="app-container police-robbery-requests">
		<div class="scale-in">
			<h1 class="display-5 app-title">
				<i class="fa-solid fa-vault me-2"></i><span translate="RobberyRequests">Robbery Requests</span>
			</h1>

			<div class="row mt-4">
				<!-- Lista de solicitudes -->
				<div class="col-4">
					<div class="bg-box h-max">
						<div class="rr-active-requests-head m-titles d-flex align-items-center justify-content-between gap-2">
							<div class="title-2 mb-0" translate="ActiveRequests">Active Requests</div>
							<span class="rr-active-count" style="display:none;" aria-live="polite">
								<span class="rr-count-num">0</span>
							</span>
						</div>
						<div class="rr-search-box mt-2">
							<i class="fa-solid fa-magnifying-glass rr-search-icon"></i>
							<input
								type="text"
								class="rr-search-input"
								translate-placeholder="SearchRobbery"
								placeholder="Buscar robo..."
								autocomplete="off"
							/>
						</div>
						<div class="rr-list mt-2"></div>
					</div>
				</div>

				<!-- Detalle -->
				<div class="col-8">
					<div class="bg-box h-max">
						<div class="m-titles rr-detail-m-titles">
							<div class="rr-detail-heading" translate="RequestDetail">Request Detail</div>
							<div class="citizen-scroll rr-detail-scroll">

								<!-- Placeholder -->
								<div class="rr-detail-placeholder">
									<i class="fa-solid fa-vault"></i>
									<h1 translate="SelectARequest">Select a request to view details</h1>
								</div>

								<!-- Contenido -->
								<div class="rr-detail-content" style="display:none;">

									<!-- Banner imagen -->
									<div class="rr-banner">
										<img class="rr-banner-img" src="" style="display:none;" />
										<div class="rr-banner-overlay">
											<div class="rr-banner-name rr-detail-robbery-name"></div>
											<div class="rr-banner-gang">
												<i class="fa-solid fa-users"></i>
												<span class="rr-detail-gang-name"></span>
											</div>
										</div>
										<span class="rr-detail-status-badge rr-banner-badge"></span>
									</div>

									<div class="rr-detail-meta">
										<div class="rr-detail-meta-grid rr-detail-meta-grid--2">
											<div class="rr-detail-stat">
												<span class="rr-detail-meta-label" translate="RequestedBy">Requested By</span>
												<span class="rr-detail-meta-value rr-detail-requested-by">—</span>
											</div>
											<div class="rr-detail-stat">
												<span class="rr-detail-meta-label" translate="RequestedAt">Requested At</span>
												<span class="rr-detail-meta-value rr-detail-requested-at">—</span>
											</div>
										</div>
										<div class="rr-detail-meta-grid rr-detail-meta-grid--3">
											<div class="rr-detail-stat">
												<span class="rr-detail-meta-label" translate="Participants">Participants</span>
												<span class="rr-detail-meta-value rr-detail-participants">—</span>
											</div>
											<div class="rr-detail-stat">
												<span class="rr-detail-meta-label" translate="RequiredCops">Required Cops</span>
												<span class="rr-detail-meta-value rr-detail-required-cops">—</span>
											</div>
											<div class="rr-detail-stat">
												<span class="rr-detail-meta-label" translate="ExpiresIn">Expires In</span>
												<span class="rr-detail-meta-value rr-detail-expires">—</span>
											</div>
										</div>
									</div>

									<!-- Acciones -->
									<div class="rr-actions">
										<div class="rr-actions-pending" style="display:none;">
											<button class="btn-action rr-btn-approve" data-id="">
												<i class="fa-solid fa-circle-check"></i>
												<span translate="Approve">Approve</span>
											</button>
											<button class="btn-action rr-btn-reject" data-id="">
												<i class="fa-solid fa-circle-xmark"></i>
												<span translate="Reject">Reject</span>
											</button>
										</div>
										<div class="rr-actions-approved" style="display:none;">
											<div class="rr-approved-notice">
												<i class="fa-solid fa-circle-check"></i>
												<span translate="RequestApproved">Request approved — waiting for gang to start</span>
											</div>
											<button class="btn-action rr-btn-started" data-id="">
												<i class="fa-solid fa-play"></i>
												<span translate="MarkStarted">Mark as Started</span>
											</button>
										</div>
									</div>

								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
